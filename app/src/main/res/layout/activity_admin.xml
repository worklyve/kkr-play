<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="#fff"
    android:layout_height="match_parent"
    tools:context=".admin">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <Button
                android:text="restart"
                android:onClick="restartt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/admin_name"/>

            <EditText
                android:id="@+id/admin_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:editable="false"
                android:text="kkr" />
            <ImageView
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:id="@+id/admin_image"/>
            <Button
                android:layout_marginTop="10dp"
                android:id="@+id/admin_choose_button"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:text="Choose file"
                android:onClick="galleryOpening"/>
            <Button
                android:id="@+id/admin_upload_button"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="Upload"
                android:onClick="uploadingFeeds"/>
            <ProgressBar
                android:id="@+id/admin_progress_bar"
                android:layout_marginTop="10dp"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="60dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>